<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!--
      Copy this file to your Maven config directory, for example:
      /usr/local/apache-maven-3.9.6/conf/settings.xml

      Recommended environment variables:
      export CENTRAL_TOKEN_USERNAME="your-central-token-username"
      export CENTRAL_TOKEN_PASSWORD="your-central-token-password"
    -->

    <servers>
        <server>
            <id>central</id>
            <username>${env.CENTRAL_TOKEN_USERNAME}</username>
            <password>${env.CENTRAL_TOKEN_PASSWORD}</password>
        </server>
    </servers>
</settings>